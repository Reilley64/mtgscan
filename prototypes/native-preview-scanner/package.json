{
  "name": "mtgscan-native-preview-scanner-prototype",
  "version": "0.0.0",
  "private": true,
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "android": "expo run:android",
    "test:native-detector": "bash scripts/test-native-detector.sh",
    "evaluate:stills": "bash scripts/evaluate-stills.sh",
    "physical-run": "bash scripts/physical-run-wizard.sh",
    "physical-run:quick": "bash scripts/physical-run-wizard.sh quick"
  },
  "dependencies": {
    "babel-preset-expo": "~54.0.10",
    "expo": "~54.0.37",
    "expo-dev-client": "~6.0.21",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-vision-camera": "4.7.3",
    "react-native-worklets-core": "1.6.3",
    "vision-camera-resize-plugin": "3.2.0"
  },
  "devDependencies": {
    "@babel/plugin-proposal-nullish-coalescing-operator": "7.18.6",
    "@babel/plugin-proposal-optional-chaining": "7.21.0",
    "@babel/plugin-transform-template-literals": "7.29.7",
    "@types/react": "~19.1.10",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4"
  }
