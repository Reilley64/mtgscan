{
  "expo": {
    "name": "Scanner Accuracy Prototype",
    "slug": "scanner-accuracy-prototype",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.reilley64.mtgscan.scannerprototype",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Allow the scanner prototype to send captured card evidence to the intentionally configured local benchmark service.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.reilley64.mtgscan.scannerprototype"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow the scanner prototype to photograph physical Magic cards.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ]
  }
}
