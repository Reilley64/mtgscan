{
  "name": "@mtgscan/mobile",
  "private": true,
  "version": "0.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "ios:test-device": "bun scripts/build-test-app.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest",
    "test:production-bundle": "bun scripts/check-production-bundle.mjs",
    "detector:test": "swift test --package-path modules/card-detector --scratch-path modules/card-detector/.data/build",
    "scan-sounds": "bun scripts/generate-scan-sounds.mjs",
    "recognizer:test": "swift test --package-path modules/card-recognizer --scratch-path modules/card-recognizer/.data/build",
    "recognizer:replay": "bun modules/card-recognizer/scripts/replay.mjs",
    "bin-deck:score": "bun test/scanner-evidence/score-bin-deck.ts"
  },
  "dependencies": {
    "@expo/ui": "~58.0.21",
    "@mtgscan/supabase": "workspace:*",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@rn-primitives/toggle": "1.5.2",
    "@rn-primitives/toggle-group": "1.5.2",
    "@shopify/flash-list": "2.3.3",
    "@supabase/supabase-js": "^2.117.3",
    "@tanstack/react-query": "^5.104.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "expo": "~58.0.16",
    "expo-apple-authentication": "~58.0.2",
    "expo-audio": "~58.0.9",
    "expo-clipboard": "~58.0.3",
    "expo-constants": "~58.0.12",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.14",
    "expo-file-system": "~58.0.10",
    "expo-font": "~58.0.9",
    "expo-glass-effect": "~58.0.4",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.16",
    "expo-keep-awake": "~58.0.3",
    "expo-linking": "~58.0.13",
    "expo-localization": "~58.0.5",
    "expo-router": "~58.0.24",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.3",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "nativewind": "~4.2.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-worklets": "0.13.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@react-native/jest-preset": "~0.88.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "^26.6.4",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.11",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.19",
    "test-renderer": "~1.2.0",
    "typescript": "~6.0.3",
    "yaml": "^2.9.1"
  },
  "expo": {
    "install": {
      "exclude": [
        "@shopify/flash-list"
      ]
    }
  },
  "jest": {
    "preset": "jest-expo",
    "testTimeout": 20000,
    "setupFiles": [
      "<rootDir>/../../node_modules/@react-native-google-signin/google-signin/jest/build/jest/setup.js",
      "<rootDir>/../../node_modules/@shopify/flash-list/jestSetup.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/test/setup.ts"
    ],
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|nativewind|@rn-primitives|@shopify/flash-list|yaml))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ],
    "moduleNameMapper": {
      "\\.css$": "<rootDir>/test/style-file.ts"
    },
    "resolver": "react-native-reanimated/jest/resolver"
  }
}
