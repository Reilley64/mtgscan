{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true,
    "types": [
      "bun"
    ]
  },
  "include": [
    "**/*.ts"
  ],
  "exclude": [
    "functions"
  ]
}
