{
  "name": "@mtgscan/supabase",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    "./buylist": "./buylist.ts",
    "./collection": "./collection.ts",
    "./converted-prices": "./converted-prices.ts",
    "./database-function": "./database-function.ts",
    "./database-functions": "./database-functions.ts",
    "./database.types": "./database.types.ts",
    "./decks": "./decks.ts",
    "./gallery-manifest": "./gallery/manifest.ts",
    "./mcp-problems": "./functions/mcp/problems.ts",
    "./planned-swaps": "./planned-swaps.ts",
    "./search": "./search.ts",
    "./sets": "./sets.ts",
    "./sign-in-providers": "./sign-in-providers.ts",
    "./test-user": "./test-user/account.ts",
    "./training-crops": "./training-crops.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && deno check --no-lock --config functions/mcp/deno.json functions/mcp && deno check --no-lock --config functions/training-crops/deno.json functions/training-crops",
    "test": "bun test",
    "types": "supabase gen types typescript --local > database.types.ts",
    "types:check": "supabase gen types typescript --local | diff database.types.ts -",
    "import": "bun import/main.ts",
    "oracle-tag": "bun import/oracle-tag.ts",
    "release-check": "bun release-check/main.ts",
    "gallery": "bun gallery/main.ts",
    "crops": "bun --env-file=.env.hosted crops/main.ts",
    "test-user": "bun test-user/main.ts",
    "apple-web-secret": "bun apple-web-secret/main.ts",
    "apple-web-secret:reminder": "bun apple-web-secret/reminder.ts",
    "mcp-preflight": "bun mcp-preflight/main.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@streamparser/json-whatwg": "^0.0.26",
    "@supabase/supabase-js": "^2.117.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "deno": "2.9.6",
    "typescript": "~6.0.3"
  }
}
